{
  "name": "runner-leave-confirm",
  "command": [
    "/usr/bin/env",
    "HOME={home}",
    "{app_bin}"
  ],
  "defaults": {
    "timeout_ms": 4500,
    "poll_interval_ms": 75
  },
  "steps": [
    {
      "name": "startup-home",
      "expect": {
        "contains": ["Home", "Status"]
      }
    },
    {
      "name": "open-library",
      "actions": [
        {"type": "key", "payload": {"key": "Down"}},
        {"type": "key", "payload": {"key": "Enter"}}
      ],
      "expect": {
        "contains": ["Library", "Tetris-like"]
      }
    },
    {
      "name": "select-tetris",
      "actions": [
        {"type": "key", "payload": {"key": "Down"}},
        {"type": "key", "payload": {"key": "Enter"}}
      ],
      "expect": {
        "contains": ["Game Detail", "Tetris-like"]
      }
    },
    {
      "name": "start-tetris",
      "actions": [
        {"type": "key", "payload": {"key": "Enter"}}
      ],
      "expect": {
        "contains": ["tetris-like | running", "NEXT"]
      }
    },
    {
      "name": "open-palette-and-request-leave",
      "actions": [
        {"type": "text", "payload": {"text": "\u000b"}},
        {"type": "key", "payload": {"key": "Enter"}}
      ],
      "expect": {
        "contains": ["Leave Active Game?", "Press Y or Enter to stop and leave."]
      }
    },
    {
      "name": "cancel-leave",
      "actions": [
        {"type": "key", "payload": {"key": "n"}}
      ],
      "expect": {
        "contains": ["tetris-like | running", "NEXT"]
      }
    },
    {
      "name": "confirm-leave",
      "actions": [
        {"type": "text", "payload": {"text": "\u000b"}},
        {"type": "key", "payload": {"key": "Enter"}},
        {"type": "key", "payload": {"key": "y"}}
      ],
      "expect": {
        "contains": ["Home", "Status"]
      }
    }
  ]
}
